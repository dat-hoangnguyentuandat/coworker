{
  "name": "coworker",
  "version": "1.0.1",
  "private": true,
  "description": "Desktop coding workspace for ChatGPT",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "pack:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "4.22.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.coworker.desktop",
    "productName": "Coworker",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "electron/assets/coworker.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
